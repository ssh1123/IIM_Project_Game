--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b6e1112b2dc58840844a8fe23438828, type: 3}
  m_Name: QuestionDatabase
  m_EditorClassIdentifier: Assembly-CSharp::QuestionDatabase
  questions:
  - questionText: "\u7B2C\u4E00\u984C\n\u5730\u65B9\u5275\u751F\u7684\u7B2C\u4E00\u6B65\u662F\u767C\u6398\u6751\u843D\u7368\u6709\u7684\u9748\u9B42\uFF0C\u6DF1\u5EA6\u76E4\u9EDE\u5728\u5730\u7684\u4EBA\u6587\u3001\u6B77\u53F2\u8207\u666F\u89C0\uFF0C\u627E\u51FA\u5C08\u5C6C\u65BC\u7576\u5730\u7684
      \uFF08____\uFF09\uFF0C\u907F\u514D\u76F2\u76EE\u8907\u88FD\u71B1\u9580\u666F\u9EDE\u3002\n"
    topText: "\u7279\u8272 DNA"
    middleText: "\u7DB2\u7F8E\u6253\u5361\u7246"
    bottomText: "\u54C1\u724C\u8B58\u5225\u7CFB\u7D71"
    correctLane: 0
    correctExplanation: "\u5730\u65B9\u5275\u751F\u7684\u7B2C\u4E00\u6B65\u662F\u300C\u7368\u7279\u6027\u300D\uFF0C\u76F2\u76EE\u8907\u88FD\u5916\u5730\u7684\u6210\u529F\u7D93\u9A57\u6216\u5927\u773E\u89C0\u5149\u6A21\u5F0F\uFF0C\u6703\u8B93\u6751\u843D\u5931\u53BB\u512A\u52E2\u3002\u552F\u6709\u76E4\u9EDE\u5728\u5730\u7684\u4EBA\u5730\u7522\uFF0C\u627E\u5230\u7368\u4E00\u7121\u4E8C\u7684
      DNA \u624D\u80FD\u5EFA\u7ACB\u9577\u671F\u5438\u5F15\u529B\u3002 "
    wrongExplanation: "\u6751\u843D\u672C\u8EAB\u7368\u6709\u7684\u4EBA\u6587\u3001\u6B77\u53F2\u8207\u666F\u89C0\uFF0C\u4EE5\u53CA\u4E0D\u53EF\u88AB\u8907\u88FD\u7684\u6838\u5FC3\u7279\u8CEA\u662F\u5730\u65B9\u5275\u751F\u7684\u91CD\u9EDE\u4E4B\u4E00"
  - questionText: "\u7B2C\u4E8C\u984C\n\u50B3\u7D71\u6587\u5316\u4E0D\u8A72\u53EA\u662F\u88AB\u4FDD\u5B58\u5728\u535A\u7269\u9928\u88E1\uFF0C\u800C\u662F\u5C07\u5728\u5730\u7684\u8001\u6545\u4E8B\u8207\u50B3\u7D71\u6280\u85DD\u91CD\u65B0\u8A2D\u8A08\u6210\u9AD4\u9A57\u884C\u7A0B\uFF0C\u8B93\u5730\u65B9\u6587\u5316\u5728\u767C\u63DA\u5149\u5927\u7684\u540C\u6642\uFF0C\u4E5F\u80FD\u5275\u9020
      \uFF08____\uFF09\u3002"
    topText: "\u6587\u5316\u4FDD\u5B58"
    middleText: "\u6587\u5316\u7D93\u6FDF"
    bottomText: "\u6587\u5316\u884C\u92B7"
    correctLane: 1
    correctExplanation: "\u6587\u5316\u4E0D\u8A72\u53EA\u662F\u4E00\u6B21\u6027\u7684\u77ED\u671F\u7092\u4F5C\uFF01\u5C07\u50B3\u7D71\u8001\u6545\u4E8B\u8207\u6280\u85DD\u5305\u88DD\u6210\u6DF1\u5EA6\u9AD4\u9A57\uFF0C\u8B93\u6587\u5316\u5E36\u4F86\u7D93\u6FDF\u6536\u76CA\uFF0C\u9019\u9805\u6587\u5316\u8207\u6751\u5B50\u624D\u80FD\u6C38\u7E8C\u7D93\u71DF\u4E0B\u53BB\u3002"
    wrongExplanation: "\u5730\u65B9\u5275\u751F\u4E0D\u53EA\u662F\u6587\u5316\u4FDD\u5B58\u6216\u5BA3\u50B3\uFF0C\u800C\u662F\u8B93\u50B3\u7D71\u6545\u4E8B\u8207\u6280\u85DD\u8F49\u5316\u70BA\u6301\u7E8C\u6027\u7684\u9AD4\u9A57\u50F9\u503C\u8207\u5730\u65B9\u6536\u76CA\u3002"
  - questionText: "\u7B2C\u4E09\u984C\n\u63A8\u52D5\u5730\u65B9\u5275\u751F\u5FC5\u9808\u5F37\u8ABF\u7531
      \uFF08____\uFF09\u7576\u5BB6\u505A\u4E3B\uFF0C\u4FDD\u6301\u5730\u65B9\u767C\u5C55\u7684\u4E3B\u9AD4\u6027\uFF0C\u518D\u4E3B\u52D5\u9023\u7D50\u653F\u5E9C\u8CC7\u91D1\u8207\u4F01\u696D\u6280\u8853\u7B49\u5916\u90E8\u8CC7\u6E90\u3002
      \r\n"
    topText: "\u5916\u5730\u5B98\u50DA"
    middleText: "\u5730\u65B9\u653F\u5E9C"
    bottomText: "\u5728\u5730\u5C45\u6C11"
    correctLane: 2
    correctExplanation: "\u5730\u65B9\u5275\u751F\u8981\u6210\u529F\uFF0C\u4E3B\u5C0E\u6B0A\u5FC5\u9808\u5728\u5728\u5730\u4EBA\u624B\u4E0A\u3002\u5982\u679C\u53EA\u4F9D\u8CF4\u5916\u5730\u5B98\u50DA\u6216\u8CA1\u5718\u5EFA\u5546\u7684\u4E3B\u5C0E\uFF0C\u5F80\u5F80\u6703\u96A8\u8CC7\u91D1\u64A4\u8D70\u800C\u6253\u56DE\u539F\u5F62\uFF0C\u552F\u6709\u5728\u5730\u5C45\u6C11\u7576\u5BB6\u505A\u4E3B\u624D\u80FD\u4FDD\u6301\u4E3B\u9AD4\u6027\u3002
      \r\n"
    wrongExplanation: "\u5916\u90E8\u8CC7\u91D1\u3001\u6280\u8853\u8207\u5C08\u696D\u53EF\u4EE5\u63D0\u4F9B\u5354\u52A9\uFF0C\u4F46\u5730\u65B9\u767C\u5C55\u7684\u4E3B\u5C0E\u6B0A\u4ECD\u9808\u638C\u63E1\u5728\u80FD\u9577\u671F\u7559\u5728\u5730\u65B9\u3001\u6700\u4E86\u89E3\u5728\u5730\u9700\u6C42\u7684\u7FA4\u9AD4\u624B\u4E2D\u3002"
  - questionText: "\u7B2C\u56DB\u984C\n\u5730\u65B9\u5275\u751F\u9664\u4E86\u8CC7\u91D1\u8207\u786C\u9AD4\uFF0C\u66F4\u9700\u8981\u5EFA\u7ACB\u6751\u6C11\u4E4B\u9593\u7684\u4FE1\u4EFB\u8207\u5408\u4F5C\uFF0C\u5C0D\u5167\u51DD\u805A\u5171\u8B58\u3001\u5C0D\u5916\u8207\u5E73\u53F0\u7D50\u76DF\uFF0C\u7D2F\u7A4D\u5F37\u5927\u7684
      \uFF08____\uFF09\u3002\r\n"
    topText: "\u793E\u6703\u8CC7\u672C"
    middleText: "\u4EBA\u529B\u8CC7\u672C"
    bottomText: "\u6587\u5316\u8CC7\u672C"
    correctLane: 0
    correctExplanation: "\u9664\u4E86\u8CC7\u91D1\u8207\u786C\u9AD4\uFF0C\u5730\u65B9\u66F4\u9700\u8981\u7121\u5F62\u7684\u8CC7\u7522\u3002\u300C\u793E\u6703\u8CC7\u672C\u300D\u6307\u7684\u662F\u6751\u6C11\u9593\u7684\u4E92\u4FE1\u8207\u5C0D\u5916\u7684\u5408\u4F5C\u7DB2\u7D61\u3002\u82E5\u9677\u5165\u731C\u5FCC\u8207\u5229\u76CA\u885D\u7A81\uFF0C\u5275\u751F\u8A08\u756B\u5C07\u96E3\u4EE5\u70BA\u7E7C\u3002"
    wrongExplanation: "\u5730\u65B9\u5275\u751F\u5F37\u8ABF\u7684\u4E0D\u662F\u8CC7\u91D1\u3001\u786C\u9AD4\u6216\u500B\u4EBA\u80FD\u529B\uFF0C\u800C\u662F\u6751\u6C11\u4E4B\u9593\u7684\u4FE1\u4EFB\u3001\u5408\u4F5C\uFF0C\u4EE5\u53CA\u8207\u5916\u90E8\u5925\u4F34\u5EFA\u7ACB\u7684\u652F\u6301\u7DB2\u7D61\u3002"
  - questionText: "\u7B2C\u4E94\u984C\n\u793E\u5340\u8CE6\u6B0A\u7684\u6838\u5FC3\u7CBE\u795E\u662F\u7FFB\u8F49\u50B3\u7D71\u904B\u4F5C\u6A21\u5F0F\uFF0C\u6539\u8B8A\u904E\u53BB\u53EA\u807D\u5F9E\u9577\u5B98\u6307\u4EE4\u7684\u4F5C\u6CD5\uFF0C\u6539\u7531\u5728\u5730\u5C45\u6C11\u767C\u8072\uFF0C\u5BE6\u65BD\uFF08____\uFF09\u7684\u81EA\u4E3B\u6C7A\u7B56\u3002
      \r\n"
    topText: "\u7531\u4E0B\u800C\u4E0A"
    middleText: "\u7531\u4E0A\u800C\u4E0B "
    bottomText: "\u59D4\u5916\u4EE3\u5DE5"
    correctLane: 0
    correctExplanation: "\u793E\u5340\u8CE6\u6B0A\u7684\u7CBE\u795E\u662F\u7FFB\u8F49\u6B0A\u529B\u95DC\u4FC2\u3002\u904E\u53BB\u7531\u4E0A\u800C\u4E0B\u7684\u5B98\u50DA\u6307\u4EE4\u5E38\u5FFD\u7565\u5728\u5730\u771F\u5BE6\u9700\u6C42\uFF1B\u6539\u7531\u5728\u5730\u5C45\u6C11\u8207\u9752\u5E74\u300C\u7531\u4E0B\u800C\u4E0A\u300D\u5171\u540C\u6C7A\u7B56\uFF0C\u624D\u80FD\u6FC0\u767C\u793E\u5340\u771F\u6B63\u7684\u6D3B\u6027\u3002
      \r\n"
    wrongExplanation: "\u6B64\u984C\u6838\u5FC3\u5728\u65BC\u7531\u5C45\u6C11\u8207\u793E\u5340\u6210\u54E1\u4E3B\u52D5\u8868\u9054\u9700\u6C42\u4E26\u53C3\u8207\u6C7A\u7B56\uFF0C\u7FFB\u8F49\u55AE\u5411\u63A5\u6536\u6307\u4EE4\u7684\u50B3\u7D71\u6A21\u5F0F\uFF0C"
