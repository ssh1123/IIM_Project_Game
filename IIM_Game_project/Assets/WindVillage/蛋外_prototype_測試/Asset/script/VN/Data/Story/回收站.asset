  - nodeId: R002
    speakerName: "\u65C1\u767D"
    bodyText: "\u68DA\u5B50\u5E95\u4E0B\u4E0D\u906E\u98A8\u4E5F\u4E0D\u64CB\u96E8\uFF0C\u5E73\u65E5\u88E1\u53EA\u6709\u9EBB\u96C0\u6703\u5728\u88E1\u982D\u843D\u8173\u3002\u90A3\u88E1\u5BC6\u5BC6\u9EBB\u9EBB\u5730\u727D\u4E86\u4E00\u6574\u6392\u8173\u8E0F\u8ECA\uFF0C\u6709\u7684\u624B\u628A\u6B6A\u4E86\u3001\u6709\u7684\u934A\u689D\u6389\u5728\u5730\u4E0A\u5403\u571F\u3001\u6709\u7684\u8ECA\u7C43\u88E1\u751A\u81F3\u9577\u51FA\u4E86\u4E0D\u77E5\u540D\u7684\u91CE\u8349\u3002\u8ECA\u8EAB\u4E0A\u539A\u539A\u7684\u9435\u93FD\uFF0C\u50CF\u662F\u6CBF\u6D77\u5E36\u9E7D\u7684\u6D77\u98A8\u7D93\u5E74\u7D2F\u6708\u5439\u51FA\u4F86\u7684\u5E74\u8F2A\u3002\r\n"
