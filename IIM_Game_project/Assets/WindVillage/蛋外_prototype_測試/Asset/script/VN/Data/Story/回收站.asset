  - nodeId: R004
    speakerName: "\u65C1\u767D"
    bodyText: "\u90A3\u6642\u5019\uFF0C\u6BCF\u8F1B\u8ECA\u7684\u4E3B\u4EBA\u662F\u8AB0\uFF0C\u807D\u8173\u8E0F\u8ECA\u7684\u9234\u943A\u8072\u5C31\u77E5\u9053\u3002
      \u300C\u90A3\u662F\u8001\u9673\u7684\u8ECA\uFF0C\u9234\u8072\u6025\u3002\u300D
      \u300C\u90A3\u662F\u9694\u58C1\u5927\u59D0\u7684\uFF0C\u934A\u689D\u7E3D\u662F\u5580\u5566\u5580\u5566\u97FF\u3002\u300D
      \u8ECA\u5B50\u5F9E\u4F86\u4E0D\u9396\uFF0C\u505C\u5728\u8DEF\u908A\uFF0C\u8AB0\u6025\u8457\u53BB\u6E2F\u53E3\u770B\u8239\u3001\u53BB\u7530\u88E1\u95DC\u6C34\uFF0C\u727D\u4E86\u5C31\u9A0E\uFF0C\u53CD\u6B63\u6700\u5F8C\u7E3D\u6703\u8F49\u56DE\u539F\u4E3B\u4EBA\u7684\u9662\u5B50\u88E1\u3002\r\n"
