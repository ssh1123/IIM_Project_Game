  - nodeId: R003
    speakerName: "\u65C1\u767D"
    bodyText: "\u9019\u88E1\u66FE\u7D93\u662F\u6751\u5B50\u6700\u8F15\u5FEB\u7684\u8072\u97F3\u3002
      \u4EE5\u524D\u6751\u5B50\u8DEF\u7A84\uFF0C\u6C7D\u8ECA\u9032\u4E0D\u4F86\uFF0C\u5927\u5BB6\u51FA\u9580\u90FD\u8E29\u8457\u4E00\u8F1B\u55AE\u8ECA\u3002
      \u6E05\u6668\uFF0C\u963F\u516C\u5011\u7684\u8ECA\u5F8C\u5EA7\u6703\u593E\u8457\u525B\u4E0B\u7530\u6458\u7684\u9752\u83DC\u3001\u6216\u662F\u525B\u4E0A\u5CB8\u9084\u5728\u8DF3\u52D5\u7684\u9B5A\u8766\uFF0C\u6CBF\u8DEF\u767C\u51FA\u300C\u5527\u5527\u2014\u2014\u5527\u5527\u2014\u2014\u300D\u7684\u6E05\u8106\u715E\u8ECA\u8072\uFF0C\u6328\u5BB6\u6328\u6236\u53BB\u9001\u83DC\u3002\u653E\u5B78\u6642\uFF0C\u5DF7\u5B50\u88E1\u5168\u662F\u5C11\u7537\u5C11\u5973\u55AE\u8ECA\u96D9\u8F09\u3001\u7B11\u9B27\u8457\u58D3\u904E\u788E\u77F3\u8DEF\u7684\u8072\u97F3\u3002\r\n"
